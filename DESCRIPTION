Title: Duncan Test, Tukey Test and Scott-Knott Test
Version: 1.0.1.9001
Authors@R: person(given = c("Laercio", "Junio", "da"), family = "Silva", role = c("aut", "cre"), email = "laerciojunio@yahoo.com.br")
